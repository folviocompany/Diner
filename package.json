{
  "name": "diner-gestao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env src/infra/prisma/seed.js",
    "db:test": "node scripts/test-database.js",
    "lint": "eslint . && node scripts/check-architecture.js",
    "test": "vitest run --project unit --project e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project e2e --coverage",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@primeuix/themes": "3.0.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "mariadb": "3.5.4",
    "pinia": "4.0.3",
    "primeicons": "8.0.1",
    "primevue": "4.5.5",
    "vue": "3.5.42",
    "vue-router": "4.6.4",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "description": "Implementação do [documento de arquitetura original](docs/arquitetura-original.md): pedidos de comanda, balcão e iFood em um único domínio, caixa com conferência, produtos com custos históricos e relatórios de resultados. Interface em português, responsiva, com Vue 3, Vite, Pinia e PrimeVue 4; API Node.js/Express 5; Prisma 7 e MySQL 8.4.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
