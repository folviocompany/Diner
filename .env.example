NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=mysql://diner:diner_local@127.0.0.1:3306/diner
STORE_TIMEZONE=America/Manaus
ADMIN_EMAIL=admin@diner.local
# Defina antes de executar npm run db:seed (mínimo de 10 caracteres).
ADMIN_PASSWORD=
SESSION_HOURS=12
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
# Percentual em pontos-base. Ex.: 1200 = 12%. Configure conforme seu contrato.
IFOOD_COMISSAO_BPS=0
WORKER_INTERVAL_MS=2000
DEMO_MODE=false

# Para MySQL remoto, use ?ssl=true na DATABASE_URL. CA própria e chave RSA são opcionais:
DATABASE_SSL_CA=
MYSQL_SERVER_RSA_KEY=
